@model wt_lab4_4mvc_makarevich.Models.TaskItem
@{
    ViewData["Title"] = "Задача";
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h1 class="mb-4">Задача #@Model.Id</h1>
            <dl class="row">
                <dt class="col-sm-3">Название</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Проект</dt>
                <dd class="col-sm-9">@Model.Project</dd>

                <dt class="col-sm-3">Исполнитель</dt>
                <dd class="col-sm-9">@Model.Assignee</dd>

                <dt class="col-sm-3">Оценка часов</dt>
                <dd class="col-sm-9">@Model.EstimatedHours</dd>

                <dt class="col-sm-3">Статус</dt>
                <dd class="col-sm-9">@(Model.IsCompleted ? "Завершена" : "В работе")</dd>
            </dl>

            <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить</a>
        </div>
    </div>
</div>