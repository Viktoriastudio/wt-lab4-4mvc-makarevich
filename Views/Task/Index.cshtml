@model List<wt_lab4_4mvc_makarevich.Models.TaskItem>
@{
    ViewData["Title"] = "Задачи";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог задач</h1>
            <p class="text-muted">Система управления IT-проектами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Добавить задачу</a>
    </div>

    <form asp-action="Search" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="text" class="form-control" placeholder="Поиск по названию..." />
            <button class="btn btn-outline-secondary" type="submit">Найти</button>
        </div>
    </form>

    @if (ViewData["SearchText"] != null)
    {
        <p class="text-muted">Результаты поиска по запросу: <strong>@ViewData["SearchText"]</strong></p>
    }

    <div class="row g-4">
        @foreach (var task in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2">ID: @task.Id</span>
                        <h5 class="card-title">@task.Title</h5>
                        <p class="mb-1"><strong>Проект:</strong> @task.Project</p>
                        <p class="mb-1"><strong>Исполнитель:</strong> @task.Assignee</p>
                        <p class="mb-1"><strong>Часы:</strong> @task.EstimatedHours</p>
                        <p class="mb-3">
                            <span class="badge @(task.IsCompleted ? "bg-success" : "bg-warning text-dark")">
                                @(task.IsCompleted ? "Завершена" : "В работе")
                            </span>
                        </p>
                        <div class="mt-auto">
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-outline-secondary btn-sm">Изменить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>